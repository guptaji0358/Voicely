/* Shared component styling. Colour tokens come from the active theme file (dark.qss / light.qss);
   the layout tokens below are shared by every theme. Hover/press feedback on buttons is animated
   in C++ (QSS cannot animate), so no :hover/:pressed background is defined for them here. */

@font-family:      "Segoe UI Variable Text", "Segoe UI", sans-serif;
@font-size:        10pt;
@font-size-small:  9pt;
@font-size-title:  14pt;
@font-size-editor: 11pt;
@radius:           9px;
@radius-lg:        16px;
@pad-h:            12px;
@pad-v:            6px;

* { font-family: @font-family; font-size: @font-size; }
QWidget { background: transparent; color: @text; }
QDialog { background: @bg; }
QMainWindow { background: transparent; }
QWidget#central { background: transparent; }

/* ---- surfaces */
QFrame#card { background: @surface; border: 1px solid @border; border-radius: @radius-lg; }

/* ---- labels */
QLabel#title { font-size: @font-size-title; font-weight: 700; color: @text; }
QLabel#sectionTitle { font-size: @font-size-small; font-weight: 600; color: @text-muted; }
QLabel#muted, QLabel#fieldLabel { color: @text-muted; }
QLabel#muted[small="true"] { font-size: @font-size-small; }
QLabel#statusLabel { color: @text-muted; }
QLabel#statusLabel[state="error"] { color: @danger; }
QLabel#outputLabel { color: @text-muted; font-size: @font-size-small; }
QLabel#timeLabel { color: @text-muted; font-family: "Cascadia Mono", "Consolas", monospace; font-size: @font-size-small; }
QLabel#statusDot { font-size: 8pt; color: @warning; }
QLabel#statusDot[state="ready"] { color: @success; }
QLabel#statusDot[state="busy"] { color: @accent; }
QLabel#statusDot[state="error"] { color: @danger; }
QLabel#emptyTitle { color: @text-muted; font-weight: 600; }

/* ---- inputs */
QPlainTextEdit, QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox {
    background: @glass-input; border: 1px solid @glass-border; border-radius: @radius;
    padding: @pad-v 8px; selection-background-color: @selection; selection-color: @text;
}
QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox { min-height: 20px; }
QPlainTextEdit:hover, QLineEdit:hover, QDoubleSpinBox:hover, QSpinBox:hover, QComboBox:hover { border-color: @border-strong; background: @glass-input-h; }
QPlainTextEdit:focus, QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus { border-color: @accent; }
QPlainTextEdit:disabled, QLineEdit:disabled, QDoubleSpinBox:disabled, QSpinBox:disabled, QComboBox:disabled {
    color: @text-disabled; background: @surface; border-color: @border;
}
QPlainTextEdit#textEditor { font-size: 12pt; padding: 14px 16px; border-radius: @radius-lg; }
QPlainTextEdit#logView { font-family: "Cascadia Mono", "Consolas", monospace; font-size: @font-size-small; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow { image: url(:/icons/combo-arrow.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: @surface-raised; border: 1px solid @border-strong; outline: none;
    selection-background-color: @selection; selection-color: @text;
}
QDoubleSpinBox::up-button, QSpinBox::up-button, QDoubleSpinBox::down-button, QSpinBox::down-button { width: 0; border: none; }

/* ---- buttons */
QPushButton {
    background: @glass-button; border: 1px solid @glass-border; border-radius: @radius;
    padding: @pad-v @pad-h; min-height: 20px;
}
QPushButton:focus { border-color: @accent; }
QPushButton:disabled { color: @text-disabled; background: @surface; border-color: @border; }
QPushButton#primary, QPushButton[variant="primary"] { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @accent-top, stop:1 @accent-bottom); border: 1px solid @accent-top; color: @on-accent; font-weight: 700; padding: 8px 20px; border-radius: 12px; }
QPushButton#primary:disabled, QPushButton[variant="primary"]:disabled { background: @accent-soft; border-color: @accent-soft; color: @text-disabled; }
QPushButton[variant="ghost"] { background: transparent; border-color: transparent; }
QPushButton[variant="danger"] { border-color: @danger; color: @danger; }

QToolButton { background: transparent; border: 1px solid transparent; border-radius: @radius; padding: 4px; color: @text-muted; }
QToolButton:focus { border-color: @accent; }
QToolButton:disabled { color: @text-disabled; }
QToolButton#previewButton { background: @glass-button; border-color: @glass-border; padding: 0; }
QToolButton#previewButton:disabled { background: @surface; }
QToolButton#logToggle { padding: 2px 6px; font-size: @font-size-small; }

/* ---- progress / slider */
QProgressBar { background: @surface-raised; border: none; border-radius: 3px; min-height: 6px; max-height: 6px; text-align: center; }
QProgressBar::chunk { background: @accent; border-radius: 3px; }
QSlider::groove:horizontal { height: 4px; background: @border; border-radius: 2px; }
QSlider::sub-page:horizontal { background: @accent; border-radius: 2px; }
QSlider::handle:horizontal { background: @text; width: 12px; margin: -4px 0; border-radius: 6px; }
QSlider::handle:horizontal:hover { background: @accent-hover; }
QSlider::handle:horizontal:disabled { background: @text-disabled; }
QSlider::sub-page:horizontal:disabled { background: @border-strong; }

/* ---- scroll bars */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: @border-strong; border-radius: 3px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical, QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; border: none; height: 0; }

/* ---- menus / tooltips */
QMenuBar { background: @bg; }
QMenuBar::item { padding: 4px 10px; background: transparent; }
QMenuBar::item:selected { background: @surface-hover; border-radius: 4px; }
QMenu { background: @surface-raised; border: 1px solid @border-strong; padding: 4px; }
QMenu::item { padding: 5px 22px; border-radius: 4px; }
QMenu::item:selected { background: @selection; }
QMenu::separator { height: 1px; background: @border; margin: 4px 6px; }
QToolTip { background: @surface-raised; color: @text; border: 1px solid @border-strong; padding: 4px 6px; }

/* ---- custom title bar */
QWidget#titleBar { background: transparent; }
QLabel#appName { font-weight: 600; color: @text; }
QLabel#backendChip { color: @text-muted; font-size: @font-size-small; padding: 2px 8px; border-radius: 9px; background: @surface-raised; }
QPushButton[variant="caption"] { background: transparent; border: none; border-radius: 0; padding: 0; min-width: 46px; max-width: 46px; min-height: 32px; }
QPushButton[variant="caption"]:focus { border: 1px solid @accent; }
QPushButton#captionClose { border-top-right-radius: 10px; }
QToolButton#commandMenu { border-radius: @radius; padding: 4px 8px; color: @text; }
QToolButton#commandMenu::menu-indicator { image: none; }

/* ---- QA panel */
QLabel#qaBadge { padding: 3px 12px; border-radius: 11px; font-weight: 600; background: @surface-raised; color: @text-muted; }
QLabel#qaBadge[state="checking"] { background: @accent-softer; color: @accent; }
QLabel#qaBadge[state="verified"] { background: @success-soft; color: @success; }
QLabel#qaBadge[state="needs_review"] { background: @warning-soft; color: @warning; }
QLabel#qaBadge[state="failed"] { background: @danger-soft; color: @danger; }
QLabel#qaNote { color: @text-muted; font-size: @font-size-small; }
QListWidget, QTableWidget, QTreeWidget { background: @surface-raised; border: 1px solid @border; border-radius: @radius; outline: none; alternate-background-color: @surface; }
QListWidget::item { padding: 5px 8px; border-radius: 4px; }
QListWidget::item:selected, QTableWidget::item:selected { background: @selection; color: @text; }
QListWidget::item:hover:!selected { background: @surface-hover; }
QHeaderView::section { background: @surface; color: @text-muted; border: none; border-bottom: 1px solid @border; padding: 5px 8px; font-weight: 600; }
QTableWidget { gridline-color: @border; }
QPushButton[variant="accent"] { border-color: @accent; color: @accent; }
QPushButton[variant="success"] { border-color: @success; color: @success; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid @border-strong; border-radius: 4px; background: @surface-raised; }
QCheckBox::indicator:hover { border-color: @accent; }
QCheckBox::indicator:checked { background: @accent; border-color: @accent; image: url(:/icons/check-white.svg); }
QCheckBox::indicator:disabled { background: @surface; border-color: @border; }
QGroupBox { border: 1px solid @border; border-radius: @radius; margin-top: 10px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: @text-muted; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QSplitter::handle { background: transparent; }
QTabWidget::pane { border: 1px solid @border; border-radius: @radius; }
QTabBar::tab { padding: 6px 14px; color: @text-muted; border: none; }
QTabBar::tab:selected { color: @text; border-bottom: 2px solid @accent; }
QStatusBar { background: transparent; }

/* ---- 3D glass additions */
QToolButton#panelToggle { color: @text; padding: 4px 10px; border-radius: @radius; }
QToolButton#panelToggle:checked { background: @accent-softer; color: @accent-top; }
QWidget#voiceStripInner { background: transparent; }
QScrollArea#voiceStrip { background: transparent; border: none; }
QScrollArea#voiceStrip > QWidget > QWidget { background: transparent; }
QLabel#voiceTitle { font-weight: 700; font-size: @font-size; color: @text; }
QLabel#stageHint { color: @text-muted; }
QWidget#waveHole { background: transparent; }
