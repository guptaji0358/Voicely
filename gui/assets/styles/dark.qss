/* Dark theme: colour tokens only. Each token is one line (at-sign, name, colon, value, semicolon);
   ThemeManager substitutes them into components.qss. Add a theme by copying this file. */

@bg:             #14161b;   /* window */
@surface:        #1a1d24;   /* cards */
@surface-raised: #20242c;   /* inputs, buttons */
@surface-hover:  #272c36;
@border:         #2a2f3a;
@border-strong:  #3a4050;
@text:           #dde1e9;
@text-muted:     #8b93a4;
@text-disabled:  #5d6475;
@accent:         #4d8dff;
@accent-hover:   #6aa1ff;
@accent-pressed: #3a74e6;
@accent-soft:    #1f2d4d;   /* disabled accent surface */
@on-accent:      #ffffff;
@success:        #3ddc84;
@warning:        #e5b84a;
@danger:         #ff6b6b;
@selection:      #2f5fc4;

/* Used from C++ only (hover/press overlays, icon and waveform colours). #AARRGGBB. */
@fx-hover:       #14ffffff;
@fx-press:       #30000000;
@icon:           #c4cad6;
@icon-active:    #ffffff;
@icon-disabled:  #5d6475;
@icon-accent:    #6ea0ff;
@wave:           #3d7eff;
@wave-idle:      #2e3442;

/* Depth tokens (floating panels, window backdrop) */
@bg-top:         #181c25;
@bg-bottom:      #0e1015;
@surface-top:    #a32a3350;   /* glass: #AARRGGBB, the 3D stage shows through */
@surface-bottom: #8c141a2a;
@shadow:         #70000000;
@highlight:      #1affffff;
@glow:           #4d8dff;
@grid:           #3d7eff;
@success-soft:   #15301f;
@warning-soft:   #3a2f12;
@danger-soft:    #3b1a1c;
@accent-softer:  #1b2740;

/* Glass tokens used by QSS (rgba so the stage shows through) */
@glass-input:    rgba(6, 9, 18, 150);
@glass-input-h:  rgba(10, 14, 26, 175);
@glass-button:   rgba(255, 255, 255, 22);
@glass-border:   rgba(255, 255, 255, 40);
@accent-top:     #6aa1ff;
@accent-bottom:  #3568de;
